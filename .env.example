# 환경 변수 예시. 이 파일을 .env로 복사하고 비밀번호를 바꿔 쓴다. .env는 절대 git에 올리지 않는다(NFR-33).

# Docker Compose 프로젝트 이름(컨테이너·볼륨 이름 앞에 붙음. compose.yaml은 저장소 최상위에 있다)
COMPOSE_PROJECT_NAME=volley

# PostgreSQL(서버 하나에 DB 셋: 서비스, airflow, mlflow)
POSTGRES_USER=volley
POSTGRES_PASSWORD=change-me
SERVICE_DB=service
AIRFLOW_DB=airflow
MLFLOW_DB=mlflow

# Django(SECRET_KEY는 길고 무작위인 값으로. DEBUG는 개발용)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django-api,django-sse
# 접속 IP마다 가입·로그인 시도 횟수 제한(선택)
AUTH_THROTTLE_RATE=10/min

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# 수집기(KOVO API 주소와 요청 간격, 네이버 뉴스 검색 API 키 — 비워 두면 RSS만 씀)
KOVO_API_BASE=https://user-api.kovo.co.kr
KOVO_MIN_INTERVAL_SEC=1.0
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 작업 실패 알림(PIPE-09): Mattermost/Slack/Discord 채널의 수신 웹훅 주소. 비우면 관리자 화면에만 기록
ALERT_WEBHOOK_URL=

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
