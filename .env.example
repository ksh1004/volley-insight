# Copy to .env and change the passwords. .env is never committed (NFR-33).

# Docker Compose project name (compose.yaml lives in the repo root)
COMPOSE_PROJECT_NAME=volley

# PostgreSQL (one server, three databases: service, airflow, mlflow)
POSTGRES_USER=volley
POSTGRES_PASSWORD=change-me
SERVICE_DB=service
AIRFLOW_DB=airflow
MLFLOW_DB=mlflow

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django-api,django-sse
# sign-up / login attempts per client IP (optional)
AUTH_THROTTLE_RATE=10/min

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Collectors
KOVO_API_BASE=https://user-api.kovo.co.kr
KOVO_MIN_INTERVAL_SEC=1.0
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Job failure alerts (PIPE-09): incoming webhook of a Mattermost/Slack/Discord channel. Empty = admin page only.
ALERT_WEBHOOK_URL=

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
